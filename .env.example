# Server (Vercel): set one of these in Project → Settings → Environment Variables.
# OPENAI_API_KEY=sk-your_key_here
# VITE_OPENAI_API_KEY=sk-your_key_here
#
# The /api/chat serverless function reads OPENAI_API_KEY first, then VITE_OPENAI_API_KEY.
# Do not rely on VITE_* in production client bundle — chat calls /api/chat; the server uses the key.
